<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
    "http://ibatis.apache.org/dtd/sql-map-2.dtd">

<sqlMap namespace="User">

    <resultMap id="userResult" class="com.example.struts.model.User">
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="namaLengkap" column="nama_lengkap"/>
    </resultMap>

    <select id="selectUserByUsername" parameterClass = "java.lang.String" resultMap="userResult">
        SELECT username, password, nama_lengkap
        FROM USERS
        WHERE username = #value#
    </select>

</sqlMap>