<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
        "http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>

    <!-- Form Beans -->
    <form-beans>
        <form-bean name="loginForm" type="com.example.struts.form.LoginForm"/>
        <form-bean name="customerForm" type="com.example.struts.form.CustomerForm"/>
    </form-beans>

    <!-- Global Forwards -->
    <global-forwards>
        <forward name="login" path="/login.jsp" redirect="true"/>
        <forward name="welcome" path="/welcome.jsp"/>
    </global-forwards>

    <!-- Action Mappings -->
    <action-mappings>
        <!-- Route: Home / Welcome -->
        <action path="/welcome" forward="/welcome.jsp"/>

        <!-- Route: Show Login -->
        <action path="/showLogin" forward="/login.jsp"/>

        <!-- Route: Login Action -->
        <action path="/login"
                type="com.example.struts.action.LoginAction"
                name="loginForm"
                scope="request"
                input="/login.jsp"
                validate="true">
            <forward name="success" path="/welcome.do" redirect="true"/>
            <forward name="failure" path="/login.jsp"/>
        </action>

        <!-- Route: Logout Action -->
        <action path="/logout"
                type="com.example.struts.action.LogoutAction">
            <forward name="success" path="/login.jsp" redirect="true"/>
        </action>

        <!-- Route: Customer Management -->
        <action path="/customer"
                type="com.example.struts.action.CustomerAction"
                name="customerForm"
                scope="request"
                input="/customer.jsp"
                validate="false">
            <forward name="list" path="/customer.jsp"/>
            <forward name="redirectList" path="/customer.do" redirect="true"/>
        </action>
    </action-mappings>

    <!-- Message Resources -->
    <message-resources parameter="ApplicationResources"/>

</struts-config>
